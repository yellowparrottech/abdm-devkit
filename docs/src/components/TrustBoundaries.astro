---
import Arrow from "./Arrow.astro";
const a = "url(#trust-arrow)";
---
<figure class="diagram">
  <svg viewBox="0 0 900 480" role="img" aria-label="Trust boundaries: your organisation's app passes an authenticated user to the DevKit on your server; the DevKit calls ABDM; ABDM's gateway and hospitals send signed callbacks and encrypted records to your callback bridge on your host or cloud, which the DevKit collects with its own token">
    <Arrow id="trust-arrow" />
    <g class="line dashed">
      <rect x="20" y="20" width="190" height="440" rx="12" />
      <rect x="235" y="20" width="270" height="440" rx="12" />
      <rect x="530" y="20" width="170" height="440" rx="12" />
      <rect x="725" y="20" width="155" height="440" rx="12" />
    </g>
    <text class="title" x="36" y="50">Your organisation</text>
    <text class="title" x="251" y="50">Your server</text>
    <text class="title" x="546" y="50">Host or cloud</text>
    <text class="title" x="741" y="50">ABDM</text>

    <g class="line">
      <path d="M115 140 V178" marker-end={a} />
      <path d="M194 210 H249" marker-end={a} />
      <path d="M370 240 V268" marker-end={a} />
      <path d="M370 360 V378" marker-end={a} />
      <path d="M741 120 H688" marker-end={a} />
      <path d="M741 278 H713 V170 H688" marker-end={a} />
      <path d="M615 190 V228" marker-end={a} />
      <path d="M546 290 H491" class="dashed" marker-end={a} />
      <path d="M489 345 H515 V440 H872 V120 H866" marker-end={a} />
    </g>
    <text class="label" x="222" y="202" text-anchor="middle">user</text>
    <text class="label" x="714" y="110" text-anchor="middle">signed</text>
    <text class="label" x="518" y="282" text-anchor="middle">collect</text>
    <text class="label" x="694" y="432" text-anchor="middle">calls to ABDM</text>

    <rect class="box" x="36" y="80" width="158" height="60" rx="8" />
    <text class="title" x="48" y="104">Person</text>
    <text class="sub" x="48" y="124">doctor or staff</text>
    <rect class="box" x="36" y="180" width="158" height="90" rx="8" />
    <text class="title" x="48" y="204">Your app</text>
    <text class="sub" x="48" y="224">logs the person in,</text>
    <text class="sub" x="48" y="240">shows each</text>
    <text class="sub" x="48" y="256">approval</text>

    <rect class="box" x="251" y="180" width="238" height="60" rx="8" />
    <text class="title" x="263" y="204">REST or MCP</text>
    <text class="sub" x="263" y="224">who is calling: set by you</text>
    <rect class="accent" x="251" y="270" width="238" height="90" rx="8" />
    <text class="title" x="263" y="294">Workflows</text>
    <text class="sub" x="263" y="314">approvals, consent rules,</text>
    <text class="sub" x="263" y="330">per-user access, audit</text>
    <rect class="box" x="251" y="380" width="238" height="70" rx="8" />
    <text class="title" x="263" y="404">Kept in memory</text>
    <text class="sub" x="263" y="424">keys, records, approvals</text>

    <rect class="box" x="546" y="80" width="140" height="110" rx="8" />
    <text class="title" x="558" y="104">Bridge</text>
    <text class="sub" x="558" y="124">checks ABDM's</text>
    <text class="sub" x="558" y="140">signature,</text>
    <text class="sub" x="558" y="156">refuses</text>
    <text class="sub" x="558" y="172">repeats</text>
    <rect class="box" x="546" y="230" width="140" height="80" rx="8" />
    <text class="title" x="558" y="254">Database</text>
    <text class="sub" x="558" y="274">encrypted, until</text>
    <text class="sub" x="558" y="290">collected</text>

    <rect class="box" x="741" y="80" width="123" height="80" rx="8" />
    <text class="title" x="753" y="104">Gateway</text>
    <text class="sub" x="753" y="124">consent and</text>
    <text class="sub" x="753" y="140">messages</text>
    <rect class="box" x="741" y="230" width="123" height="96" rx="8" />
    <text class="title" x="753" y="254">Hospital</text>
    <text class="sub" x="753" y="274">sends</text>
    <text class="sub" x="753" y="290">encrypted</text>
    <text class="sub" x="753" y="306">records</text>
  </svg>
  <figcaption>Dashed boxes are trust boundaries. Each arrow crosses one, and each crossing is checked: your app vouches for the user, ABDM signs its messages, and the DevKit collects from the bridge with its own token.</figcaption>
</figure>
