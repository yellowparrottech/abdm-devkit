{
  "name": "@yellowparrottech/abdm-devkit",
  "version": "0.0.0",
  "description": "Command-line tool for the YellowParrot ABDM DevKit: run the mock environment as a local REST API",
  "keywords": [
    "abdm",
    "abha",
    "ayushman-bharat",
    "health",
    "fhir",
    "consent",
    "india"
  ],
  "homepage": "https://abdm.yellowparrottech.com",
  "bugs": {
    "url": "https://github.com/yellowparrottech/abdm-devkit/issues"
  },
  "license": "Apache-2.0",
  "author": "YellowParrot Technologies Private Limited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellowparrottech/abdm-devkit.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "abdm-devkit": "./dist/main.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@yellowparrottech/abdm-mcp-server": "workspace:*",
    "@yellowparrottech/abdm-rest-adapter": "workspace:*"
  }
}
